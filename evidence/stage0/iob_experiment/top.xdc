set_property PACKAGE_PIN AL8 [get_ports clk_p]
set_property PACKAGE_PIN AL7 [get_ports clk_n]
set_property IOSTANDARD DIFF_SSTL12 [get_ports {clk_p clk_n}]
create_clock -period 3.333 -name clk300 [get_ports clk_p]
set_property PACKAGE_PIN A20 [get_ports hd_out]
set_property PACKAGE_PIN B20 [get_ports hd_in]
set_property IOSTANDARD LVCMOS33 [get_ports {hd_in hd_out}]
set_property DRIVE 12 [get_ports hd_out]
set_property SLEW FAST [get_ports hd_out]
set_property IOSTANDARD LVCMOS18 [get_ports {hp_in hp_out}]
set_property SLEW FAST [get_ports hp_out]
set_property DRIVE 12 [get_ports hp_out]
set_input_delay 0 -clock clk300 [get_ports {hd_in hp_in}]
set_output_delay 0 -clock clk300 [get_ports {hd_out hp_out}]
set_property PACKAGE_PIN AD2 [get_ports hp_out]
set_property PACKAGE_PIN AD1 [get_ports hp_in]
